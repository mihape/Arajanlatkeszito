{
  "name": "nyilaszaro-ajanlatkeszito",
  "version": "0.1.0",
  "private": true,
  "author": "mihape",
  "description": "Helyi adatbazisu nyilaszaros ajanlatkeszito Windows/Electron app.",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "electron .",
    "check": "node --check app.js && node --check src/main/main.js && node --check src/preload/preload.js",
    "build:win": "electron-builder --win nsis",
    "build:win:dir": "electron-builder --win dir"
  },
  "build": {
    "appId": "hu.nyilaszaro.ajanlatkeszito",
    "productName": "Nyilaszaro Ajanlatkeszito",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  }
}
